[Unit]
Description=screenloop: timed video loop on HDMI with a phone control page

[Service]
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStart=/usr/bin/python3 %h/.local/share/screenloop/screenloop.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
